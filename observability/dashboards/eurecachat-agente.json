{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Grafana Cloud Metrics",
      "description": "Fonte Prometheus que recebe as métricas do Alloy.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_LOKI",
      "label": "Grafana Cloud Logs",
      "description": "Fonte Loki que recebe os logs JSON do backend.",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "annotations": { "list": [] },
  "description": "Visão Grafana do relatório de observabilidade do agente. Ferramentas e tokens dependem das métricas do backend; traces detalhados, prompts e mensagens continuam no Phoenix.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": [],
      "title": "Resumo do agente",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" },
      "targets": [{ "expr": "sum(increase(eureca_backend_chat_requests_total{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\"}[$__range])) or vector(0)", "instant": true, "legendFormat": "Turnos", "refId": "A" }],
      "title": "Turnos no período",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" },
      "targets": [{ "expr": "sum(increase(eureca_backend_tool_executions_total{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\", tool=~\"$tool\"}[$__range])) or vector(0)", "instant": true, "legendFormat": "Execuções", "refId": "A" }],
      "title": "Execuções de ferramentas",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "s", "decimals": 2 }, "overrides": [] },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" },
      "targets": [{ "expr": "sum(increase(eureca_backend_tool_duration_seconds_sum{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\", tool=~\"$tool\"}[$__range])) / clamp_min(sum(increase(eureca_backend_tool_duration_seconds_count{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\", tool=~\"$tool\"}[$__range])), 1)", "instant": true, "legendFormat": "Média", "refId": "A" }],
      "title": "Tempo médio por execução",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" },
      "targets": [{ "expr": "sum(increase(eureca_backend_llm_tokens_total{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\"}[$__range])) or vector(0)", "instant": true, "legendFormat": "Tokens", "refId": "A" }],
      "title": "Tokens de LLM",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" },
      "targets": [{ "expr": "sum(increase(eureca_backend_tool_executions_total{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\", tool=~\"$tool\", status=\"error\"}[$__range])) or vector(0)", "instant": true, "legendFormat": "Erros", "refId": "A" }],
      "title": "Erros de ferramentas",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "percent", "decimals": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 15 }] } }, "overrides": [] },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" },
      "targets": [{ "expr": "100 * sum(increase(eureca_backend_tool_executions_total{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\", tool=~\"$tool\", status=\"error\"}[$__range])) / clamp_min(sum(increase(eureca_backend_tool_executions_total{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\", tool=~\"$tool\"}[$__range])), 1)", "instant": true, "legendFormat": "Taxa", "refId": "A" }],
      "title": "Taxa de erro das ferramentas",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 12, "lineWidth": 2, "showPoints": "never" }, "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sum by (status) (rate(eureca_backend_chat_requests_total{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\"}[$__rate_interval]))", "legendFormat": "{{status}}", "refId": "A" }],
      "title": "Turnos por resultado",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 12, "lineWidth": 2, "showPoints": "never" }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, status) (rate(eureca_backend_chat_duration_seconds_bucket{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\"}[$__rate_interval])))", "legendFormat": "{{status}}", "refId": "A" }],
      "title": "Latência p95 por resultado",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "panels": [],
      "title": "Ferramentas e tokens",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" }, "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sum by (tool) (rate(eureca_backend_tool_executions_total{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\", tool=~\"$tool\"}[$__rate_interval]))", "legendFormat": "{{tool}}", "refId": "A" }],
      "title": "Execuções por ferramenta",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sum by (tool) (rate(eureca_backend_tool_duration_seconds_sum{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\", tool=~\"$tool\"}[$__rate_interval])) / clamp_min(sum by (tool) (rate(eureca_backend_tool_duration_seconds_count{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\", tool=~\"$tool\"}[$__rate_interval])), 0.001)", "legendFormat": "{{tool}}", "refId": "A" }],
      "title": "Tempo médio por ferramenta",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" }, "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sum by (tool) (rate(eureca_backend_tool_executions_total{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\", tool=~\"$tool\", status=\"error\"}[$__rate_interval]))", "legendFormat": "{{tool}}", "refId": "A" }],
      "title": "Erros por ferramenta",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(eureca_backend_llm_tokens_total{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\", direction=\"input\"}[$__rate_interval]))", "legendFormat": "Entrada", "refId": "A" },
        { "expr": "sum(rate(eureca_backend_llm_tokens_total{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\", direction=\"output\"}[$__rate_interval]))", "legendFormat": "Saída", "refId": "B" }
      ],
      "title": "Tokens por segundo",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sum by (authenticated) (rate(eureca_backend_chat_requests_total{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\"}[$__rate_interval]))", "legendFormat": "autenticado={{authenticated}}", "refId": "A" }],
      "title": "Turnos por tipo de usuário",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "panels": [],
      "title": "Falhas e investigação",
      "type": "row"
    },
    {
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 32 },
      "options": {
        "code": { "language": "plaintext", "showLineNumbers": false, "showMiniMap": false },
        "content": "Este painel usa métricas agregadas do Prometheus e logs do Loki. Usuários únicos, execuções agrupadas por turno, tokens por ferramenta, prompts, respostas e spans individuais continuam disponíveis no relatório conectado ao Phoenix.",
        "mode": "markdown"
      },
      "title": "Escopo dos dados no Grafana",
      "transparent": true,
      "type": "text"
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 36 },
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyJSON": true, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "expr": "{project=\"eurecachat\", environment=\"$environment\", service=\"backend\"} |~ \"(?i)erro|exception|traceback\"", "refId": "A" }],
      "title": "Erros recentes do backend",
      "type": "logs"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 41,
  "tags": ["eurecachat", "agente", "phoenix", "grafana", "observability"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "local", "value": "local" },
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(up{project=\"eurecachat\"}, environment)",
        "includeAll": false,
        "label": "Ambiente",
        "name": "environment",
        "options": [],
        "query": { "query": "label_values(up{project=\"eurecachat\"}, environment)", "refId": "PrometheusVariableQueryEditor-Environment" },
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "Todas", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(eureca_backend_tool_executions_total{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\"}, tool)",
        "includeAll": true,
        "label": "Ferramenta",
        "multi": true,
        "name": "tool",
        "options": [],
        "query": { "query": "label_values(eureca_backend_tool_executions_total{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\"}, tool)", "refId": "PrometheusVariableQueryEditor-Tool" },
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "EurecaChat — Agente",
  "uid": "eurecachat-agente",
  "version": 1,
  "weekStart": ""
}
