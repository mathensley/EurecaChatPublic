      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 13 },
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, status, authenticated) (rate(eureca_backend_chat_duration_seconds_bucket{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\"}[$__rate_interval])))", "legendFormat": "{{status}} · auth={{authenticated}}", "refId": "A" }],
      "title": "Duração p95 dos chats",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
