{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Grafana Cloud Metrics",
      "description": "Fonte Prometheus que recebe as métricas do Alloy.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_LOKI",
      "label": "Grafana Cloud Logs",
      "description": "Fonte Loki que recebe os logs JSON do backend.",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": [],
      "title": "Backend",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [{ "options": { "0": { "color": "red", "text": "Indisponível" }, "1": { "color": "green", "text": "Disponível" } }, "type": "value" }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" },
      "targets": [{ "expr": "max(up{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\"}) or vector(0)", "legendFormat": "Backend", "refId": "A" }],
      "title": "Disponibilidade do backend",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 70 }, { "color": "red", "value": 90 }] }, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 5, "x": 4, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "expr": "100 * rate(process_cpu_seconds_total{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\"}[5m])", "legendFormat": "Backend", "refId": "A" }],
      "title": "CPU do processo backend",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1073741824 }, { "color": "red", "value": 2147483648 }] }, "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 5, "x": 9, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "expr": "process_resident_memory_bytes{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\"}", "legendFormat": "Backend", "refId": "A" }],
      "title": "Memória residente do backend",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 10, "x": 14, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "description": "Total de conexões Socket.IO ativas, incluindo usuários anônimos e autenticados.",
      "targets": [{ "expr": "sum(eureca_backend_socket_connections{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\"}) or vector(0)", "legendFormat": "Conexões", "refId": "A" }],
      "title": "Conexões Socket.IO",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 12, "lineWidth": 2, "showPoints": "never" }, "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 6 },
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sum by (route) (rate(eureca_backend_http_requests_total{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\"}[$__rate_interval]))", "legendFormat": "{{route}}", "refId": "A" }],
      "title": "Requisições HTTP por rota",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 12, "lineWidth": 2, "showPoints": "never" }, "min": 0, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 6 },
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "100 * sum(rate(eureca_backend_http_requests_total{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\", status_class=\"4xx\"}[$__rate_interval])) / clamp_min(sum(rate(eureca_backend_http_requests_total{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\"}[$__rate_interval])), 0.001)", "legendFormat": "4xx", "refId": "A" },
        { "expr": "100 * sum(rate(eureca_backend_http_requests_total{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\", status_class=\"5xx\"}[$__rate_interval])) / clamp_min(sum(rate(eureca_backend_http_requests_total{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\"}[$__rate_interval])), 0.001)", "legendFormat": "5xx", "refId": "B" }
      ],
      "title": "Taxa de erros HTTP",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 12, "lineWidth": 2, "showPoints": "never" }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 6 },
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, route) (rate(eureca_backend_http_request_duration_seconds_bucket{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\"}[$__rate_interval])))", "legendFormat": "{{route}}", "refId": "A" }],
      "title": "Latência HTTP p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 12, "lineWidth": 2, "showPoints": "never" }, "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 13 },
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sum by (status, authenticated) (rate(eureca_backend_chat_requests_total{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\"}[$__rate_interval]))", "legendFormat": "{{status}} · auth={{authenticated}}", "refId": "A" }],
