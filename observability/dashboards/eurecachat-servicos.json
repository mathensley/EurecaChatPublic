      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 13 },
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sum by (event, status) (rate(eureca_backend_socket_events_total{project=\"eurecachat\", environment=\"$environment\", job=\"integrations/backend\"}[$__rate_interval]))", "legendFormat": "{{event}} · {{status}}", "refId": "A" }],
      "title": "Eventos Socket.IO",
      "type": "timeseries"
    },
