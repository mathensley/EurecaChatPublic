# API KEYS
OPENAI_API_KEY=""
DEEPINFRA_API_TOKEN=""
TAVILY_API_KEY=""

#Executar: base64 -w 0 "/home/levi/Downloads/crucial-engine-486216-j1-7f8b62b34938.json nas credenciais baixadas."
GOOGLE_SERVICE_ACCOUNT_JSON_B64=BASE64_DO_JSON_DA_CONTA_DE_SERVICO

# DB / Docker
POSTGRES_USER=eureca_chat
POSTGRES_PASSWORD=eureca_chat_admin
POSTGRES_DB=eureca_chat_db
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
CONTAINER_NAME=eureca_postgres

# LOGGER
DOCKER_ENV=true
APP_ORIGIN=http://localhost:8000
COOKIE_SECURE=false

# MODELS (ChatOpenAI)
# Endpoint para modelos hospedados fora da OpenAI.
PROVIDER_URL="https://api.deepinfra.com/v1/openai"

AGENT_MODEL="gpt-5.4-mini-2026-03-17" # OpenAI
CHECK_MSG_MODEL="openai/gpt-oss-20b" # DeepInfra (deepseek-ai/DeepSeek-V4-Flash - melhor como checador)
SUMMARIZER_MODEL="openai/gpt-oss-20b"
TOOL_SELECTOR_MODEL="openai/gpt-oss-20b"
CHAT_TITLE_MODEL="openai/gpt-oss-20b"
SQL_MODEL="gpt-5.4-mini-2026-03-17"

# TRACING PHOENIX
ENABLE_TRACING=true
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006/v1/traces
PHOENIX_PROJECT_NAME=EurecaChat
PHOENIX_ENDPOINT=http://phoenix:6006

# AUTH PHOENIX
PHOENIX_SECRET=SECRET # Gerar secret
PHOENIX_DEFAULT_ADMIN_INITIAL_PASSWORD="Admin@123456" # Substituir a senha ao fazer o login pela primeira vez
PHOENIX_API_KEY=API_KEY # Criar na interface do Phoenix após login

# RATE LIMITING (tokens/dia)
DAILY_TOKEN_LIMIT_USER=3000000  # Limite para usuários autenticados (por matrícula)
DAILY_TOKEN_LIMIT_ANON=150000  # Limite para usuários anônimos (por IP)

# GRAFANA CLOUD / OBSERVABILIDADE
# Mantenha ENABLE_GRAFANA_OBSERVABILITY=false fora da VM monitorada. Para subir o coletor, use: docker compose --profile observability up -d --build
ENABLE_GRAFANA_OBSERVABILITY=false
OBSERVABILITY_ENVIRONMENT=production
OBSERVABILITY_INSTANCE=eureca-vm

# Credencial exclusiva e somente para métricas do PostgreSQL.
POSTGRES_MONITOR_PASSWORD=""

# Copie estes valores da página "Send data" da sua stack no Grafana Cloud.
# As URLs devem incluir os caminhos completos de push.
GRAFANA_CLOUD_METRICS_URL=""
GRAFANA_CLOUD_METRICS_USERNAME=""
GRAFANA_CLOUD_LOKI_URL=""
GRAFANA_CLOUD_LOKI_USERNAME=""
GRAFANA_CLOUD_API_KEY=""
